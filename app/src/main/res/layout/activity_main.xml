<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/gradient_green_background">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">

                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_edittext"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="12dp"
                        android:hint="Search patients..."
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/dark_gray"
                        android:textSize="16sp"
                        android:elevation="8dp"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"/>

                    <ImageButton
                        android:id="@+id/clearButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignEnd="@id/searchEditText"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Clear search"
                        android:elevation="8dp"/>

                </RelativeLayout>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>




        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Admin Dashboard"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/notificationButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_notification"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/white"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Popular"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/addButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circular_button_with_outline"
                    android:src="@drawable/ic_add_vector"
                    android:contentDescription="Add"
                    android:padding="20dp"
                    android:elevation="6dp"
                    android:layout_margin="5dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:stateListAnimator="@animator/button_elevation"
                    app:tint="@color/black"/>

                <ImageButton
                    android:id="@+id/updateButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circular_button_with_outline"
                    android:src="@drawable/ic_update_vector"
                    android:contentDescription="Update"
                    android:padding="20dp"
                    android:elevation="6dp"
                    android:layout_margin="5dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:stateListAnimator="@animator/button_elevation"
                    app:tint="@color/black"/>

                <ImageButton
                    android:id="@+id/deleteButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circular_button_with_outline"
                    android:src="@drawable/ic_delete_vector"
                    android:contentDescription="Delete"
                    android:padding="20dp"
                    android:elevation="6dp"
                    android:layout_margin="5dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:stateListAnimator="@animator/button_elevation"
                    app:tint="@color/black"/>

                <ImageButton
                    android:id="@+id/readButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circular_button_with_outline"
                    android:src="@drawable/baseline_library_books_24"
                    android:contentDescription="Read"
                    android:padding="20dp"
                    android:elevation="6dp"
                    android:layout_margin="5dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:stateListAnimator="@animator/button_elevation"
                    app:tint="@color/black"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registered Patients"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/greenPrimary"
                android:layout_margin="16dp"
                android:elevation="4dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp"
                android:background="@color/white"/>

            <!-- Pagination at the bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:background="#F5F5F5"
                android:elevation="8dp">

                <ImageButton
                    android:id="@+id/prevButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_selector"
                    android:src="@drawable/ic_prev"
                    android:contentDescription="Previous"
                    android:padding="12dp"
                    android:elevation="4dp"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:id="@+id/pageNumberTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="18sp"
                    android:textColor="@color/greenPrimary"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="24dp"/>

                <ImageButton
                    android:id="@+id/nextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_selector"
                    android:src="@drawable/ic_next"
                    android:contentDescription="Next"
                    android:padding="12dp"
                    android:elevation="4dp"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/greenPrimary"
        app:itemTextColor="@color/white"
        app:itemIconTint="@color/white"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/nav_menu"
        app:itemTextAppearance="@style/NavigationDrawerStyle"/>

</androidx.drawerlayout.widget.DrawerLayout>
